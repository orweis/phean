# Copy to .env.local for local development. Every variable is optional locally.
# On Vercel, set them in Project Settings -> Environment Variables (see docs/DEPLOYMENT.md).

# Database. Defaults to embedded PGlite in ./.data/pglite when unset.
# Forms: postgres://... (Neon on Vercel sets this), pglite:./path, pglite:memory
# DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Signs sessions. Required in production; generate with: openssl rand -base64 32
# BETTER_AUTH_SECRET=

# Canonical public URL. Defaults to the Vercel URL, or http://localhost:3000.
# BETTER_AUTH_URL=http://localhost:3000

# Comma-separated, verified emails with read-only access to every workspace.
# PHEAN_PLATFORM_ADMINS=ops@example.com

# Optional social sign-in. Callback: <BETTER_AUTH_URL>/api/auth/callback/github
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Callback: <BETTER_AUTH_URL>/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
