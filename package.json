{
  "name": "phean",
  "version": "0.2.0",
  "private": true,
  "description": "Phean - hosted, multi-tenant task & goal management for AI agents. You point at the hill; your agents roll the boulder.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "dev": "pnpm db:migrate && next dev",
    "build": "next build",
    "vercel-build": "pnpm db:migrate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "pnpm db:migrate && tsx scripts/seed.ts",
    "demo:agents": "tsx scripts/demo-agents.ts",
    "auth:schema": "auth generate --config src/server/auth/auth.ts --output src/server/db/schema/auth.ts --yes"
  },
  "dependencies": {
    "@electric-sql/pglite": "~0.5.14",
    "@modelcontextprotocol/server": "2.4.0",
    "@vercel/functions": "^3.10.5",
    "better-auth": "1.7.15",
    "drizzle-orm": "0.45.4",
    "geist": "^1.9.0",
    "lucide-react": "^1.66.0",
    "mcp-handler": "2.3.0",
    "next": "16.4.4",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@next/env": "16.4.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "auth": "1.7.15",
    "drizzle-kit": "0.31.11",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
