{
  "name": "phean",
  "version": "0.2.0",
  "private": true,
  "description": "Phean - hosted, multi-tenant task & goal management for AI agents. You point at the hill; your agents roll the boulder.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "dev": "pnpm db:migrate && next dev",
    "build": "next build",
    "vercel-build": "pnpm db:migrate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "themes": "tsx scripts/themes.ts",
    "test:e2e": "next build && playwright test",
    "e2e:serve": "rm -rf .data/e2e && pnpm db:seed && next start --port 3200",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "pnpm db:migrate && tsx scripts/seed.ts",
    "demo:agents": "tsx scripts/demo-agents.ts",
    "auth:schema": "auth generate --config src/server/auth/auth.config.ts --output src/server/db/schema/auth.ts --yes"
  },
  "dependencies": {
    "@better-auth/cimd": "1.7.26",
    "@better-auth/mcp": "1.7.26",
    "@better-auth/oauth-provider": "1.7.26",
    "@electric-sql/pglite": "~0.5.17",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@vercel/blob": "2.9.0",
    "@vercel/functions": "^3.11.3",
    "better-auth": "1.7.26",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^1.66.0",
    "mcp-handler": "2.4.0",
    "mermaid": "12.3.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "server-only": "^0.0.1",
    "three": "0.187.0",
    "uqr": "0.1.3",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@next/env": "16.4.6",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.187.0",
    "@types/ws": "^8.18.2",
    "auth": "1.7.26",
    "drizzle-kit": "0.31.11",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "overrides": {
      "zod@<4.6.6": "^4.6.7"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
